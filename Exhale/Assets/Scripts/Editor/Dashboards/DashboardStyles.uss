.btn-toolbar {
    -unity-font-style: bold-and-italic;
    width: auto;
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/Plugins/Graphy%20-%20Ultimate%20Stats%20Monitor/Font/Roboto/Roboto-Bold.ttf?fileID=12800000&guid=9568ece128856a54cbc1060379ab498d&type=3#Roboto-Bold");
    white-space: normal;
    flex-direction: column;
    flex-grow: 1;
}

.btn-toolbar-active {
    -unity-font-style: bold-and-italic;
    width: auto;
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/Plugins/Graphy%20-%20Ultimate%20Stats%20Monitor/Font/Roboto/Roboto-Bold.ttf?fileID=12800000&guid=9568ece128856a54cbc1060379ab498d&type=3#Roboto-Bold");
    white-space: normal;
    flex-direction: column;
    flex-grow: 1;
    background-color: rgb(77, 77, 77);
}

.toggle-trait-filter {
    width: auto;
    flex-direction: row-reverse;
    align-items: stretch;
    flex-wrap: wrap;
    align-self: flex-start;
    padding-top: 3px;
    padding-right: 3px;
    padding-bottom: 3px;
    padding-left: 3px;
    -unity-font-style: normal;
    -unity-paragraph-spacing: 0;
    -unity-font: url('project://database/Assets/Plugins/TextMesh%20Pro/Fonts/TT%20Norms%20Pro%20Medium.otf?fileID=12800000&guid=173dbf27823bb413992952cb24ca3801&type=3#TT Norms Pro Medium');
}

.toggle-trait-filter .unity-label {
    padding-left: 10px;
}

.box-editor-noid {
    border-left-color: rgb(123, 123, 123);
    border-right-color: rgb(123, 123, 123);
    border-top-color: rgb(123, 123, 123);
    border-bottom-color: rgb(123, 123, 123);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-radius: 10px;
    padding: 20px;
    margin: 10px;
}

.box-editor-noid .unity-group-box__label {
    -unity-font-style: bold;
}

.container-filter-trait-description {
    flex-grow: 1;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 10px;
    padding-left: 5px;
    margin-bottom: 10px;
    border-left-color: rgb(180, 180, 180);
    border-right-color: rgb(180, 180, 180);
    border-top-color: rgb(180, 180, 180);
    border-bottom-color: rgb(180, 180, 180);
    border-top-width: 1px;
    border-right-width: 0;
    border-bottom-width: 1px;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    margin-right: 15px;
    margin-left: 5px;
    margin-top: 5px;
}

.list-label-object-template {
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-left-color: rgba(179, 179, 179, 0.57);
    border-right-color: rgba(179, 179, 179, 0.57);
    border-top-color: rgba(179, 179, 179, 0.57);
    border-bottom-color: rgba(179, 179, 179, 0.57);
    margin-top: 3px;
    margin-right: 3px;
    margin-bottom: 3px;
    margin-left: 3px;
    -unity-text-align: middle-center;
    font-size: 11px;
    -unity-font-style: normal;
    height: 30px;
    flex-grow: 0;
    width: 150px;
    flex-shrink: 0;
}

.label-highlight {
    background-color: rgba(130, 128, 128, 0.39);
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    color: rgb(210, 210, 210);
    margin-top: 3px;
    margin-right: 3px;
    margin-bottom: 3px;
    margin-left: 3px;
    -unity-text-align: middle-center;
    width: 150px;
    height: 30px;
}

.label-table-header {
    font-size: 15px;
    -unity-font-style: bold;
    padding-top: 5px;
    padding-right: 0;
    padding-bottom: 5px;
    padding-left: 0;
    margin-top: 1px;
    margin-right: 1px;
    margin-bottom: 1px;
    margin-left: 1px;
    -unity-text-align: middle-center;
    background-color: rgba(89, 89, 89, 0.39);
    -unity-font: url("project://database/Assets/Plugins/Graphy%20-%20Ultimate%20Stats%20Monitor/Font/Roboto/Roboto-Bold.ttf?fileID=12800000&guid=9568ece128856a54cbc1060379ab498d&type=3#Roboto-Bold");
    border-left-color: rgb(123, 123, 123);
    border-right-color: rgb(123, 123, 123);
    border-top-color: rgb(123, 123, 123);
    border-bottom-color: rgb(123, 123, 123);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
}

.list-label-object-template-error {
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-left-color: rgba(255, 0, 0, 0.57);
    border-right-color: rgba(255, 0, 0, 0.57);
    border-top-color: rgba(255, 0, 0, 0.57);
    border-bottom-color: rgba(255, 0, 0, 0.57);
    margin-top: 3px;
    margin-right: 3px;
    margin-bottom: 3px;
    margin-left: 3px;
    -unity-text-align: middle-center;
    font-size: 11px;
    -unity-font-style: normal;
}

.foldout-traits-filter {
    margin-top: 2px;
    margin-right: 2px;
    margin-bottom: 10px;
    margin-left: 2px;
    padding-top: 15px;
    padding-right: 15px;
    padding-bottom: 15px;
    padding-left: 15px;
    flex-grow: 0;
    border-left-color: rgb(123, 123, 123);
    border-right-color: rgb(123, 123, 123);
    border-top-color: rgb(123, 123, 123);
    border-bottom-color: rgb(123, 123, 123);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    width: 100%;
    flex-shrink: 0;
}

.foldout-traits-filter .unity-foldout__toggle {
    -unity-font-style: bold;
}
