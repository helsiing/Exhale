<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:VisualElement name="debug-game-object-container" style="flex-grow: 0; flex-direction: row; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; border-left-color: rgba(180, 180, 180, 0.2); border-right-color: rgba(180, 180, 180, 0.2); border-top-color: rgba(180, 180, 180, 0.2); border-bottom-color: rgba(180, 180, 180, 0.2); border-top-width: 0; border-right-width: 0; border-bottom-width: 1px; border-left-width: 0; flex-wrap: nowrap; height: 100px;">
        <ui:VisualElement name="object-thumbnail-container" style="flex-grow: 0; width: 5%; height: auto; align-self: center; align-items: center;">
            <ui:VisualElement name="object-thumbnail-image" style="flex-grow: 0; width: 50px; height: 50px; justify-content: center; align-self: center; align-items: center;" />
        </ui:VisualElement>
        <ui:Label tabindex="-1" text="Label" parse-escape-sequences="true" display-tooltip-when-elided="true" name="object-name" style="flex-grow: 0; -unity-text-align: middle-left; -unity-font: initial; -unity-font-style: bold-and-italic; color: rgb(197, 197, 197); padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px; font-size: 12px; flex-wrap: wrap; flex-direction: column; flex-shrink: 0; width: 25%; white-space: normal;" />
        <ui:VisualElement name="object-traits" style="flex-grow: 0; flex-direction: row; flex-wrap: wrap; width: 65%; align-self: center;" />
        <ui:VisualElement name="actions-container" style="flex-grow: 0; width: 5%; justify-content: center; flex-shrink: 0;">
            <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="button-select" style="width: 30px; height: 30px; background-image: url(&quot;project://database/Assets/Core/Content/Art/UI/_old/CompassIcon.png?fileID=2800000&amp;guid=3e772263932ef4e4787eeb89ba008817&amp;type=3#CompassIcon&quot;); -unity-background-scale-mode: stretch-to-fill; -unity-slice-left: 7; -unity-slice-top: 7; -unity-slice-right: 7; -unity-slice-bottom: 7; -unity-background-image-tint-color: rgb(180, 180, 180); background-color: rgb(88, 88, 88); align-items: center; justify-content: center; flex-direction: column; flex-wrap: wrap; align-self: flex-end;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
